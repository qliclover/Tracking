# Copy to .env.local (for `vercel dev`) or set in your Vercel project settings.

# Required to enable receipt scanning and voice entry.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for vision + parsing.
# Defaults to a stable, vision-capable Claude model.
# AI_MODEL=claude-3-5-sonnet-latest
